{
  "name": "echoflux-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:vercel": "vercel dev",
    "build": "vite build",
    "preview": "vite preview",
    "env:backup-local": "node scripts/backup-env-local.mjs",
    "env:snapshot:vercel": "vercel env pull .env.vercel.snapshot",
    "env:snapshot:vercel:production": "vercel env pull .env.vercel.production.snapshot --environment=production",
    "typecheck": "npm run typecheck:app",
    "typecheck:app": "tsc -p tsconfig.app.json",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "test:e2e": "playwright test",
    "stripe:health": "node scripts/stripeHealthCheck.mjs",
    "deploy": "firebase deploy --only hosting",
    "migrate:stormij:dry": "npx ts-node --esm scripts/migrate-stormij.ts --dry-run",
    "migrate:stormij": "npx ts-node --esm scripts/migrate-stormij.ts",
    "backfill:fan-hub": "npx ts-node --esm scripts/backfill-fan-hub-preferences.ts",
    "sync:fan-dm-threads": "npx ts-node --esm scripts/sync-conversations-to-fanDmThreads.ts",
    "backfill:stormij-purchases-to-grants": "npx ts-node --esm scripts/backfillStormijPurchasesToGrants.ts",
    "backfill:fan-spend-from-orders": "npx ts-node --esm scripts/backfillFanSpendFromOrders.ts",
    "reparent:creator": "npx ts-node --esm scripts/reparentCreatorArtifacts.ts",
    "upsert:creator-domain": "npx ts-node --esm scripts/upsertCreatorDomain.ts",
    "report:fans-missing-auth": "npx ts-node --esm scripts/reportFansMissingAuth.ts",
    "diagnose:purchases-migration": "npx ts-node --esm scripts/diagnosePurchasesMigration.ts",
    "merge:fan-to-auth-uid": "npx ts-node --esm scripts/mergeFansDocToAuthUid.ts",
    "backfill:creator-app-claims": "npx ts-node --esm scripts/backfillCreatorAppClaims.ts",
    "backfill:fan-subscription-access": "npx ts-node --esm scripts/backfillFanSubscriptionAccess.ts"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@google/generative-ai": "^0.24.1",
    "@sentry/react": "^10.32.1",
    "@stripe/stripe-js": "^8.6.0",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.36.1",
    "@vercel/node": "^5.5.10",
    "axios": "^1.13.2",
    "cloudinary": "^2.8.0",
    "firebase": "^10.12.0",
    "firebase-admin": "^13.6.0",
    "formidable": "^3.5.4",
    "lucide-react": "^0.378.0",
    "nodemailer": "^6.9.15",
    "openai": "^6.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "replicate": "^1.4.0",
    "stripe": "^20.1.0",
    "vercel": "^48.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
